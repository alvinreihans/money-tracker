# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Google AI Studio (Gemini) --- server-only, JANGAN pakai NEXT_PUBLIC_
GEMINI_API_KEY=your-gemini-api-key

# --- Groq (ekstraksi teks OCR -> JSON) --- server-only
GROQ_API_KEY=your-groq-api-key

# --- Koneksi Postgres (hanya untuk npm run db:migrate, tidak dipakai app) ---
# Dashboard -> Connect -> Session pooler.
#
# PAKAI SESSION POOLER, bukan Direct connection. Host direct
# (db.<ref>.supabase.co) hanya beralamat IPv6, dan kebanyakan ISP rumah di
# Indonesia belum memberi IPv6 -> gagal dengan ENOTFOUND.
#
# Perhatikan username ikut berubah jadi postgres.<project-ref>.
# Port 5432 = session mode (mendukung DDL). JANGAN 6543 (transaction mode).
#
# sslmode=no-verify diperlukan karena pooler Supabase memakai sertifikat CA
# sendiri. Koneksi tetap terenkripsi, hanya identitas server yang tidak
# diverifikasi -- dipakai untuk menjalankan migrasi dari mesin lokal.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=no-verify

# Push notifikasi (SPEC-notifikasi.md). Buat kunci: npx web-push generate-vapid-keys
# CRON_SECRET: string acak; Vercel mengirimnya sebagai Authorization: Bearer
# ke route cron. SUPABASE_SERVICE_ROLE_KEY (Project Settings → API keys) dipakai cron untuk
# membaca data semua pelanggan lewat RPC data_notifikasi().
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
